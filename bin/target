#!/bin/bash
# Target - Herramienta de gestión de objetivos para pentesting.
# Uso: target <subcomando> [opciones]
# Refactorizado: lógica en lib/target_*.sh; este script solo dispatcher.

SCRIPT_DIR="$(dirname "$(readlink -f -- "$0")")"
REPO_BASE="$(dirname "$SCRIPT_DIR")"

# Colores y common primero (para mensajes de error al cargar config)
source "$REPO_BASE/lib/target_common.sh"

# Carga de configuración
CONFIG_FILE="$REPO_BASE/conf/target.conf"
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=conf/target.conf
    source "$CONFIG_FILE"
else
    echo -e "${RED}Error: Archivo de configuración no encontrado: $CONFIG_FILE${NC}"
    exit 1
fi

source "$REPO_BASE/lib/tmux_helpers.sh"
source "$REPO_BASE/lib/target_help.sh"
source "$REPO_BASE/lib/target_tmux.sh"
source "$REPO_BASE/lib/target_tmux_layout.sh"
source "$REPO_BASE/lib/target_workspace.sh"
source "$REPO_BASE/lib/target_scan.sh"
source "$REPO_BASE/lib/target_list.sh"
source "$REPO_BASE/lib/target_note.sh"
source "$REPO_BASE/lib/target_dirsearch.sh"
source "$REPO_BASE/lib/target_venv.sh"

if [ $# -eq 0 ]; then
    show_help
    exit 1
fi

case "$1" in
    add)
        target_add "$2" "$3"
        ;;
    scan)
        shift
        main_target_scan "$@"
        ;;
    list)
        target_list
        ;;
    info)
        shift
        target_info "$@"
        ;;
    note)
        shift
        target_note "$@"
        ;;
    dirsearch)
        shift
        target_dirsearch "$@"
        ;;
    venv)
        shift
        target_venv "$@"
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo -e "${RED}Error: Subcomando '$1' no reconocido${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
