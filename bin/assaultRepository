#!/bin/bash

# Get the base directory of the repo (assume this script is in bin/)
SCRIPT_DIR="$(dirname "$(readlink -f -- "$0")")"
REPO_BASE="$(dirname "$SCRIPT_DIR")"

# AssaultRepository - HTTP Server for Pentesting Tools
# Usage: assaultRepository <subcommand> [options]

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to show help
show_help() {
    echo -e "${BLUE}AssaultRepository - Servidor HTTP para Herramientas de Pentesting${NC}"
    echo ""
    echo "Uso: assaultRepository <subcomando> [opciones]"
    echo ""
    echo "Subcomandos disponibles:"
    echo "  start [puerto]                  - Iniciar servidor HTTP (puerto por defecto: 8000)"
    echo "  stop                            - Detener servidor HTTP"
    echo "  status                          - Mostrar estado del servidor"
    echo "  add <nombre_herramienta> <ruta_archivo> - Agregar herramienta al repositorio"
    echo "  list                            - Listar todas las herramientas disponibles"
    echo "  help                            - Mostrar esta ayuda"
    echo ""
    echo "Ejemplos:"
    echo "  assaultRepository start"
    echo "  assaultRepository start 9000"
    echo "  assaultRepository add pspy /ruta/a/pspy"
    echo "  assaultRepository list"
}

# Function to start HTTP server
start_server() {
    local port=${1:-8000}
    local repo_dir="$REPO_BASE/assaultrepository"
    local pid_file="$REPO_BASE/.assaultrepository.pid"
    
    # Check if server is already running
    if [ -f "$pid_file" ]; then
        local pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
            echo -e "${YELLOW}El servidor ya está ejecutándose en PID $pid${NC}"
            return
        else
            # PID file exists but process is dead, clean it up
            rm -f "$pid_file"
        fi
    fi
    
    # Create repository directory if it doesn't exist
    mkdir -p "$repo_dir"
    
    echo -e "${GREEN}Iniciando servidor HTTP en puerto $port...${NC}"
    echo -e "${YELLOW}Directorio del repositorio: $repo_dir${NC}"
    echo -e "${YELLOW}Accede a tus herramientas en: http://0.0.0.0:$port${NC}"
    
    # Start Python HTTP server in background and save PID
    cd "$repo_dir"
    python3 -m http.server "$port" >/dev/null 2>&1 &
    local server_pid=$!
    
    # Save PID to file
    echo "$server_pid" > "$pid_file"
    
    echo -e "${GREEN}Servidor iniciado exitosamente con PID $server_pid${NC}"
    echo -e "${YELLOW}Usa 'assaultRepository stop' para detener el servidor${NC}"
}

# Function to stop server
stop_server() {
    local pid_file="$REPO_BASE/.assaultrepository.pid"
    
    if [ ! -f "$pid_file" ]; then
        echo -e "${YELLOW}No se encontró archivo PID del servidor. El servidor puede no estar ejecutándose.${NC}"
        return
    fi
    
    local pid=$(cat "$pid_file")
    
    if ! kill -0 "$pid" 2>/dev/null; then
        echo -e "${YELLOW}El proceso del servidor (PID $pid) no está ejecutándose. Limpiando archivo PID.${NC}"
        rm -f "$pid_file"
        return
    fi
    
    echo -e "${GREEN}Deteniendo servidor (PID $pid)...${NC}"
    kill "$pid"
    
    # Wait a moment and check if process was killed
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
        echo -e "${RED}Falló al detener el servidor de forma elegante. Forzando terminación...${NC}"
        kill -9 "$pid"
    fi
    
    rm -f "$pid_file"
    echo -e "${GREEN}Servidor detenido exitosamente${NC}"
}

# Function to show server status
show_status() {
    local pid_file="$REPO_BASE/.assaultrepository.pid"
    local repo_dir="$REPO_BASE/assaultrepository"
    
    echo -e "${BLUE}=== Estado de AssaultRepository ===${NC}"
    echo ""
    
    # Check if PID file exists
    if [ ! -f "$pid_file" ]; then
        echo -e "${RED}Estado: El servidor no está ejecutándose${NC}"
        echo ""
        echo -e "${YELLOW}Directorio del repositorio: $repo_dir${NC}"
        if [ -d "$repo_dir" ]; then
            echo -e "${YELLOW}Repositorio existe: Sí${NC}"
        else
            echo -e "${YELLOW}Repositorio existe: No${NC}"
        fi
        return
    fi
    
    local pid=$(cat "$pid_file")
    
    # Check if process is running
    if kill -0 "$pid" 2>/dev/null; then
        echo -e "${GREEN}Estado: El servidor está ejecutándose${NC}"
        echo -e "${GREEN}PID: $pid${NC}"
        
        # Try to get port information
        local port=$(netstat -tlnp 2>/dev/null | grep "$pid" | awk '{print $4}' | cut -d: -f2 | head -1)
        if [ -n "$port" ]; then
            echo -e "${GREEN}Puerto: $port${NC}"
            echo -e "${YELLOW}URL: http://0.0.0.0:$port${NC}"
        fi
        
        # Get process info
        local process_info=$(ps -p "$pid" -o pid,ppid,cmd --no-headers 2>/dev/null)
        if [ -n "$process_info" ]; then
            echo -e "${YELLOW}Proceso: $process_info${NC}"
        fi
    else
        echo -e "${RED}Estado: Existe archivo PID del servidor pero el proceso no está ejecutándose${NC}"
        echo -e "${YELLOW}PID: $pid (proceso muerto)${NC}"
        echo -e "${YELLOW}Limpiando archivo PID obsoleto...${NC}"
        rm -f "$pid_file"
    fi
    
    echo ""
    echo -e "${YELLOW}Directorio del repositorio: $repo_dir${NC}"
    if [ -d "$repo_dir" ]; then
        echo -e "${YELLOW}Repositorio existe: Sí${NC}"
        local file_count=$(find "$repo_dir" -type f | wc -l)
        echo -e "${YELLOW}Archivos en el repositorio: $file_count${NC}"
    else
        echo -e "${YELLOW}Repositorio existe: No${NC}"
    fi
}

# Function to add tool to repository
add_tool() {
    if [ $# -ne 2 ]; then
        echo -e "${RED}Error: Uso: assaultRepository add <nombre_herramienta> <ruta_archivo>${NC}"
        exit 1
    fi
    
    local tool_name=$1
    local file_path=$2
    local repo_dir="$REPO_BASE/assaultrepository"
    
    # Create repository directory if it doesn't exist
    mkdir -p "$repo_dir"
    
    if [ ! -f "$file_path" ]; then
        echo -e "${RED}Error: El archivo $file_path no existe${NC}"
        exit 1
    fi
    
    # Copy tool to repository
    cp "$file_path" "$repo_dir/$tool_name"
    chmod +x "$repo_dir/$tool_name"
    
    echo -e "${GREEN}Herramienta $tool_name agregada al repositorio${NC}"
}

# Function to list tools
list_tools() {
    local repo_dir="$REPO_BASE/assaultrepository"
    
    if [ ! -d "$repo_dir" ]; then
        echo -e "${YELLOW}El directorio del repositorio aún no existe${NC}"
        return
    fi
    
    echo -e "${BLUE}Herramientas disponibles en el repositorio:${NC}"
    if [ -z "$(ls -A "$repo_dir")" ]; then
        echo -e "${YELLOW}No se encontraron herramientas en el repositorio${NC}"
    else
        ls -la "$repo_dir"
    fi
}

# Main command logic
case "${1:-help}" in
    "start")
        start_server "$2"
        ;;
    "stop")
        stop_server
        ;;
    "status")
        show_status
        ;;
    "add")
        add_tool "$2" "$3"
        ;;
    "list")
        list_tools
        ;;
    "help"|*)
        show_help
        ;;
esac 